---
import { SITE, type Lang } from '../lib/site';
import { t } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
const f = ui.form;
const key = import.meta.env.PUBLIC_FORM_KEY ?? '';
const msgs = { sending: f.sending, sent: f.sent, sentMailto: f.sentMailto, error: f.error, invalid: f.invalid, required: f.required, invalidEmail: f.invalidEmail, send: f.send };
---
<form class="form" novalidate data-form data-key={key} data-email={SITE.email} data-msgs={JSON.stringify(msgs)}>
  <div class="form__status form__status--ok" role="status" hidden data-ok></div>
  <div class="form__status form__status--err" role="alert" hidden data-err></div>

  <div class="field">
    <label for="f-name">{f.name}</label>
    <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-e" />
    <span class="field__err" id="f-name-e"></span>
  </div>
  <div class="field">
    <label for="f-email">{f.email}</label>
    <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="f-email-e" />
    <span class="field__err" id="f-email-e"></span>
  </div>
  <div class="field">
    <label for="f-msg">{f.message}</label>
    <textarea id="f-msg" name="message" rows="5" required aria-describedby="f-msg-e"></textarea>
    <span class="field__err" id="f-msg-e"></span>
  </div>
  <!-- Honeypot anti-spam: los humanos no lo ven ni lo llenan -->
  <div class="hp" aria-hidden="true">
    <label>No llenar <input type="text" name="botcheck" tabindex="-1" autocomplete="off" /></label>
  </div>
  <button type="submit">{f.send}</button>
</form>

<script src="../scripts/contact.ts"></script>
